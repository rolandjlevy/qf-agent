# ── Required ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxx
# Neon Postgres connection string, used by lib/db.js and `npm run db:migrate`.
# For local dev, use a dedicated Neon branch, not production's.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# ── Models (optional; blank = default) ──────────────────────────────────
# Main agent loop and draft_section. Default: claude-sonnet-4-6
CLAUDE_MODEL=
# Web UI Phase A (clarify + propose materials). Default: claude-haiku-4-5-20251001
PHASE_A_MODEL=
# Web UI Phase B (draft the quote). Default: CLAUDE_MODEL
PHASE_B_MODEL=
# CLI's identify_materials extraction. Default: claude-haiku-4-5-20251001
IDENTIFY_MATERIALS_MODEL=
# Site-photo analysis (one vision call per job). Default: CLAUDE_MODEL
PHOTO_ANALYSIS_MODEL=
# Anthropic request timeout in ms. Default: 60000
REQUEST_TIMEOUT_MS=

# ── Price search (optional) ─────────────────────────────────────────────
# Google Shopping via https://serper.dev. Blank = mock fixture data.
SERPER_API_KEY=
# true = mock data even when SERPER_API_KEY is set. Default: false
SERPER_MOCK_MODE=
# 'serper' (default) or 'dataforseo' (unimplemented skeleton).
PRICE_PROVIDER=
# price_search_cache row lifetime in seconds. Default: 604800 (7 days)
PRICE_CACHE_TTL_SECONDS=

# ── Job photos (optional) ───────────────────────────────────────────────
# Private Vercel Blob store. Blank = photo routes return 503.
BLOB_READ_WRITE_TOKEN=

# ── Example-job photos (optional) ───────────────────────────────────────
# Unsplash API Access Key (not the Secret Key), from unsplash.com/oauth/applications.
# Used by scripts/unsplash-examples.mjs and the download-report route. Blank = no reporting.
UNSPLASH_ACCESS_KEY=
# Your app's name as registered on Unsplash, used as utm_source in photo credit links.
UNSPLASH_APP_NAME=
