ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-6
# Neon Postgres connection string. Required in every environment (local dev,
# tests, production) — there's no local/embedded fallback. For local dev, use
# a dedicated Neon branch rather than pointing at the same branch as production.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Optional. Enables live per-quote price scraping on the web app (see
# CLAUDE.md's "Live per-quote scraping"). A hosted-browser WebSocket
# endpoint, e.g. Browserless: wss://production-sfo.browserless.io?token=xxx
# Leave unset to keep using the existing scraped_prices cache / placeholder
# chain — lookup_price degrades to that automatically.
BROWSERLESS_WS_ENDPOINT=
# Optional, default off. Last-resort price lookup via Claude's own web
# search when a material matches nothing in the catalog/cache/live-scrape
# chain — see CLAUDE.md's "Web-search price fallback". Real testing found
# this succeeds only a minority of the time (the underlying search tool's
# own retry/error behaviour, not something this app controls) and costs
# real API tokens (~$0.07-0.26 observed per attempt) whether it succeeds or
# not — enable deliberately, not by default.
ENABLE_WEB_SEARCH_PRICE_FALLBACK=
