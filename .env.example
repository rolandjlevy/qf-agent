ANTHROPIC_API_KEY=sk-ant-xxx
CLAUDE_MODEL=claude-sonnet-4-6
# Neon Postgres connection string. Required in every environment (local dev,
# tests, production) — there's no local/embedded fallback. For local dev, use
# a dedicated Neon branch rather than pointing at the same branch as production.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# Google Shopping price search (lib/pricing) — from https://serper.dev dashboard.
# Leave unset for local dev: SerperPriceSearchProvider falls back to mock
# fixture data automatically when this is empty, same as SERPER_MOCK_MODE=true.
SERPER_API_KEY=xxx
# Force mock fixture data even when SERPER_API_KEY is set (e.g. to keep tests
# and local dev off the real API on purpose). Optional, defaults to unset/false.
SERPER_MOCK_MODE=false
# Optional. 'serper' (default) or 'dataforseo' — see lib/pricing/index.js.
PRICE_PROVIDER=serper
# Optional. Cache TTL for price_search_cache rows, in seconds. Defaults to
# 172800 (48h) — see lib/pricing/cache/DbCacheStore.js.
PRICE_CACHE_TTL_SECONDS=172800